# Copy this file to .env for local development.
#
# The web app URL from Apps Script (Deploy → Manage deployments). The URL also decides
# which Google account receives the photos: the one that deployed the script. To send
# photos to a different account, deploy the script from that account and use its URL.
# It is not a secret, since it ends up in the public site. Leave it empty to run the
# in-browser demo instead.
#
# Never put the staff password here; it belongs in the Apps Script's script properties.
VITE_APPS_SCRIPT_URL=



# Google App Script Properties
STAFF_PASSWORD=
FOLDER_ID=optional
SHEET_ID=optional